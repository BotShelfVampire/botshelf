//@version=6
indicator("BSV Liquidity Sweep Alert", overlay=true)

leftBars = input.int(3, "Pivot left", minval=1)
rightBars = input.int(3, "Pivot right", minval=1)
atrLength = input.int(14, "ATR length", minval=1)
minSweepAtr = input.float(0.05, "Minimum sweep as ATR fraction", minval=0.0, step=0.01)

ph = ta.pivothigh(high, leftBars, rightBars)
pl = ta.pivotlow(low, leftBars, rightBars)
atr = ta.atr(atrLength)

var float lastPivotHigh = na
var float lastPivotLow = na

if not na(ph)
    lastPivotHigh := ph
if not na(pl)
    lastPivotLow := pl

bearSweep = not na(lastPivotHigh) and high > lastPivotHigh and close < lastPivotHigh and (high - lastPivotHigh) >= atr * minSweepAtr
bullSweep = not na(lastPivotLow) and low < lastPivotLow and close > lastPivotLow and (lastPivotLow - low) >= atr * minSweepAtr

plot(lastPivotHigh, "Last Pivot High", color=color.new(color.red, 45), style=plot.style_linebr)
plot(lastPivotLow, "Last Pivot Low", color=color.new(color.green, 45), style=plot.style_linebr)

plotshape(bearSweep, title="Bearish sweep candidate", style=shape.triangledown, location=location.abovebar, size=size.tiny, text="SW")
plotshape(bullSweep, title="Bullish sweep candidate", style=shape.triangleup, location=location.belowbar, size=size.tiny, text="SW")

alertcondition(bearSweep, "Bearish liquidity sweep candidate", "BSV: bearish liquidity sweep candidate")
alertcondition(bullSweep, "Bullish liquidity sweep candidate", "BSV: bullish liquidity sweep candidate")

// This is a mechanical heuristic, not an institutional order-flow claim.
// Pivots are confirmed after rightBars bars. No profitability claim.
