//@version=6
indicator("BSV Webhook Alert Router", overlay=true)

fastLength = input.int(9, "Fast EMA", minval=1)
slowLength = input.int(20, "Slow EMA", minval=2)

fast = ta.ema(close, fastLength)
slow = ta.ema(close, slowLength)

crossUp = ta.crossover(fast, slow)
crossDown = ta.crossunder(fast, slow)

plot(fast, "Fast EMA", color=color.yellow)
plot(slow, "Slow EMA", color=color.blue)

if crossUp
    msg = '{"event":"ema_cross_up","ticker":"' + syminfo.ticker + '","timeframe":"' + timeframe.period + '","close":' + str.tostring(close) + '}'
    alert(msg, alert.freq_once_per_bar_close)

if crossDown
    msg = '{"event":"ema_cross_down","ticker":"' + syminfo.ticker + '","timeframe":"' + timeframe.period + '","close":' + str.tostring(close) + '}'
    alert(msg, alert.freq_once_per_bar_close)

// Configure a TradingView alert using "Any alert() function call".
// Do not put API secrets in the payload or script.
// ORIGINAL BSV starter. Alerts only; no live order placement.
