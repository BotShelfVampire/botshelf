{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://botshelfvampire.com/schemas/bsv-trader-recipe.schema.json",
  "title": "BSV Trader Recipe",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "overlay",
    "blocks"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "overlay": {
      "type": "boolean"
    },
    "changelog": {
      "type": "array",
      "description": "Dated record of functional changes to this recipe, shown on its recipe page.",
      "items": {
        "type": "object",
        "required": [
          "date",
          "en",
          "ja"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "en": {
            "type": "string",
            "maxLength": 1000
          },
          "ja": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "params"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": {
            "enum": [
              "indicator.ema",
              "indicator.sma",
              "indicator.rsi",
              "indicator.atr",
              "data.higher_timeframe",
              "filter.session",
              "structure.pivot",
              "structure.range",
              "signal.cross",
              "signal.threshold",
              "signal.combine",
              "signal.recent",
              "signal.breakout",
              "signal.liquidity_sweep",
              "signal.divergence",
              "risk.atr_band",
              "scanner.symbol_set",
              "visual.plot",
              "visual.zone",
              "visual.table",
              "alert.condition",
              "alert.webhook"
            ]
          },
          "params": {
            "type": "object"
          }
        }
      }
    }
  }
}
