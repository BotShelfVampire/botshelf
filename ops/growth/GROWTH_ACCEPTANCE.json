    },
    {
      "id": "real-content",
      "expected": "Every promoted domain has several useful source-backed resources or workflows, no empty coming-soon category.",
      "status": "unverified"
    },
    {
      "id": "three-journeys",
      "expected": "Business, everyday and trader entry explains input, output, runtime, access requirement and next step; recommendations link to actual detail pages.",
      "status": "unverified"
    },
    {
      "id": "ja-readable",
      "expected": "Read visible/accessibility UI and representative full bodies in JA; translate ordinary prose and keep functioning code/prompts/identifiers intact. Do not scan raw bilingual HTML as visible leakage.",
      "status": "unverified"
    },
    {
      "id": "access-copy",
      "expected": "BSV gated body/download access is distinguished from free public summaries and original-author links; no change to auth behavior.",
      "status": "unverified"
    },
    {
      "id": "honest-examples",
      "expected": "Synthetic examples explicitly labelled, no invented performance, customers, partnerships or runtime evidence.",
      "status": "unverified"
    },
    {
      "id": "responsive",
      "expected": "Check 390x844 and 1280x900, EN/JA, keyboard focus, overflow, overlap and navigation.",
      "status": "unverified"
    },
    {
      "id": "regression",
      "expected": "Existing search, registration/source gates, marketplace vs library distinction and production email health checks remain valid; no transaction test or real order.",
      "status": "unverified"
    },
    {
      "id": "astra-release-review",
      "expected": "Astra reviews exact candidate revision plus implementation diff, tests, browser evidence and remaining limitations before production release.",
      "status": "unverified"
    }
